{
  "name": "Resource",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "description": "URL slug for the resource page (e.g. /resources/my-article)"
    },
    "title": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "description": "Category label shown on the card, e.g. Guide, Playbook, AI Search"
    },
    "excerpt": {
      "type": "string",
      "description": "Short summary shown on the resources listing card"
    },
    "body": {
      "type": "string",
      "description": "Rich text HTML content for the article body"
    },
    "image_url": {
      "type": "string",
      "description": "Hero image for the article"
    },
    "author": {
      "type": "string"
    },
    "author_name": {
      "type": "string",
      "description": "Full name of the author shown in the author box"
    },
    "author_position": {
      "type": "string",
      "description": "Author role or job title, e.g. 'Head of SEO'"
    },
    "author_description": {
      "type": "string",
      "description": "Short bio for the author box"
    },
    "author_image_url": {
      "type": "string",
      "description": "Author avatar/photo shown in the author box"
    },
    "author_twitter": {
      "type": "string",
      "description": "Twitter/X profile URL"
    },
    "author_linkedin": {
      "type": "string",
      "description": "LinkedIn profile URL"
    },
    "author_website": {
      "type": "string",
      "description": "Author personal website URL"
    },
    "read_time": {
      "type": "string",
      "description": "e.g. '6 min read'"
    },
    "date": {
      "type": "string",
      "description": "Display date, e.g. 'Sep 2026'"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "slug",
    "title"
  ]
}