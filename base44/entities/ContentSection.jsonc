{
  "name": "ContentSection",
  "type": "object",
  "properties": {
    "page_path": {
      "type": "string",
      "description": "Page path or pattern (e.g. / or /platform/:slug)"
    },
    "section_name": {
      "type": "string",
      "description": "Admin label for this section"
    },
    "heading": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Rich text HTML content"
    },
    "image_url": {
      "type": "string",
      "description": "Optional section image"
    },
    "image_alt": {
      "type": "string",
      "description": "Alt text for the section image"
    },
    "image_position": {
      "type": "string",
      "enum": [
        "top",
        "left",
        "right"
      ],
      "default": "top",
      "description": "Where the image sits relative to the text"
    },
    "link_url": {
      "type": "string",
      "description": "Internal link URL for CTA button"
    },
    "link_label": {
      "type": "string",
      "description": "CTA button label"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "background": {
      "type": "string",
      "enum": [
        "white",
        "slate",
        "indigo"
      ],
      "default": "white"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "page_path",
    "section_name"
  ]
}