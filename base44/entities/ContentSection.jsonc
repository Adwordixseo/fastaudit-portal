{
  "name": "ContentSection",
  "type": "object",
  "properties": {
    "page_path": {
      "type": "string",
      "description": "Page path or pattern (e.g. / or /platform/:slug)"
    },
    "section_name": {
      "type": "string",
      "description": "Admin label for this section"
    },
    "heading": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "description": "Rich text HTML content"
    },
    "image_url": {
      "type": "string",
      "description": "Optional section image"
    },
    "image_alt": {
      "type": "string",
      "description": "Alt text for the section image"
    },
    "image_position": {
      "type": "string",
      "enum": [
        "top",
        "left",
        "right"
      ],
      "default": "top",
      "description": "Where the image sits relative to the text"
    },
    "columns": {
      "type": "number",
      "default": 1,
      "description": "Number of columns for body text layout (1, 2, or 3)"
    },
    "link_url": {
      "type": "string",
      "description": "Primary internal link URL for CTA button"
    },
    "link_label": {
      "type": "string",
      "description": "Primary CTA button label"
    },
    "extra_links": {
      "type": "array",
      "description": "Additional internal links to display alongside the primary CTA",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Internal link URL"
          },
          "label": {
            "type": "string",
            "description": "Link label"
          }
        }
      }
    },
    "replace_section": {
      "type": "string",
      "enum": [
        "",
        "hero",
        "platform",
        "how_it_works",
        "solutions",
        "pricing",
        "resources",
        "cta",
        "features",
        "steps",
        "faq",
        "body",
        "testimonials",
        "stats"
      ],
      "default": "",
      "description": "Which hardcoded page section this replaces (empty = standalone section added to the page)"
    },
    "hide_default": {
      "type": "boolean",
      "default": false,
      "description": "When true with replace_section set, hide the default section entirely without rendering a replacement"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "background": {
      "type": "string",
      "enum": [
        "white",
        "slate",
        "indigo"
      ],
      "default": "white"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "page_path",
    "section_name"
  ]
}