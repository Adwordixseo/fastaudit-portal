{
  "name": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_monthly": {
      "type": "number"
    },
    "price_quarterly": {
      "type": "number"
    },
    "price_yearly": {
      "type": "number"
    },
    "highlight": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price_monthly"
  ]
}