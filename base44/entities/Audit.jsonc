{
  "name": "Audit",
  "type": "object",
  "properties": {
    "url": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "overall_score": {
      "type": "number"
    },
    "scores": {
      "type": "object",
      "properties": {
        "seo": {
          "type": "number"
        },
        "performance": {
          "type": "number"
        },
        "content": {
          "type": "number"
        },
        "technical": {
          "type": "number"
        },
        "ai_readiness": {
          "type": "number"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "word_count": {
      "type": "number"
    },
    "checks": {
      "type": "array",
      "description": "Deterministic pass/fail/warning checks computed from the live page, grouped by section",
      "items": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "enum": [
              "on_page_seo",
              "technical",
              "content",
              "performance",
              "ai_readiness",
              "social",
              "local_seo"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warning",
              "fail",
              "info"
            ]
          },
          "value": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "description": "Top keywords found in page content and where they appear",
      "items": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string"
          },
          "count": {
            "type": "number"
          },
          "in_title": {
            "type": "boolean"
          },
          "in_meta": {
            "type": "boolean"
          },
          "in_headings": {
            "type": "boolean"
          }
        }
      }
    },
    "technology": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "url"
  ]
}