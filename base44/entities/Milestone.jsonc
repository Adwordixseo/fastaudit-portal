{
  "name": "Milestone",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "done"
      ],
      "default": "pending"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "project_id",
    "title"
  ]
}