{
  "name": "FaqItem",
  "type": "object",
  "properties": {
    "page_path": {
      "type": "string",
      "description": "URL path or pattern this FAQ belongs to, e.g. / or /platform/:slug"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "page_path",
    "question",
    "answer"
  ]
}