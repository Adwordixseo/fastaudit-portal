{
  "name": "FaqItem",
  "type": "object",
  "properties": {
    "page_path": {
      "type": "string",
      "description": "URL path or pattern this FAQ belongs to, e.g. / or /platform/:slug"
    },
    "question": {
      "type": "string"
    },
    "answer": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "description": "Interlinking links shown under the answer, e.g. [{ label: 'See pricing', url: '/pricing' }]",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Anchor text shown for the link"
          },
          "url": {
            "type": "string",
            "description": "Internal path (e.g. /pricing) or full external URL"
          }
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "page_path",
    "question",
    "answer"
  ]
}