{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "assigned_to_email": {
      "type": "string",
      "description": "Email of the team member assigned to this project"
    },
    "assigned_to_name": {
      "type": "string",
      "description": "Display name of the assigned team member"
    },
    "status": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "completed"
      ],
      "default": "todo"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "client_id"
  ]
}