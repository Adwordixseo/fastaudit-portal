{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_email": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "on_hold",
        "completed"
      ],
      "default": "active"
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "client_id"
  ]
}