{
  "name": "User",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "gmb_url": {
      "type": "string",
      "description": "Google My Business listing URL, if available"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "is_team_member": {
      "type": "boolean",
      "default": false,
      "description": "Grants access to the team panel (distinct from platform role)"
    }
  }
}